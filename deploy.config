# HSC Proshop deployment configuration.
# This file contains no credentials. Keep production secrets in the server .env.

DEPLOY_BRANCHES="main"
GIT_BRANCH=main

# The script discovers APP_PATH from its own location. Override PUBLIC_HTML on
# the server only when the web root is not the sibling public_html directory.
PUBLIC_HTML="${PUBLIC_HTML:-$(cd "$APP_PATH/.." && pwd)/public_html}"

RUN_BACKUP="${RUN_BACKUP:-true}"
RUN_MIGRATIONS="${RUN_MIGRATIONS:-true}"
MIGRATION_PATHS="database/migrations/2026_09_03_160000_create_invoice_payment_attempts_table.php database/migrations/2026_09_07_000100_create_invoice_scanning_tables.php database/migrations/2026_09_11_000100_harden_invoice_receiving_workflow.php database/migrations/2026_09_11_000200_create_inventory_control_tables.php"

# Run deploy-hsc main --with-lights-migrations only after the separate,
# least-privilege Lights database credentials have been configured in .env.
RUN_LIGHTS_MIGRATIONS="${RUN_LIGHTS_MIGRATIONS:-false}"
LIGHTS_MIGRATION_PATHS="database/migrations/lights/2026_09_03_180000_create_lights_portal.php database/migrations/lights/2026_09_03_190000_add_start_request_keys.php database/migrations/lights/2026_09_03_200000_create_lights_control_sessions.php database/migrations/lights/2026_09_03_210000_add_live_payment_fields.php database/migrations/lights/2026_09_03_220000_add_customer_control_fields.php database/migrations/lights/2026_09_03_230000_create_manual_light_commands.php database/migrations/lights/2026_09_03_250000_add_status_attempt_to_lights_worker.php database/migrations/lights/2026_09_03_260000_add_duration_to_manual_light_commands.php database/migrations/lights/2026_09_03_270000_add_midnight_cutoff_to_lights_worker.php database/migrations/lights/2026_09_03_280000_add_client_readiness_fields.php"

INSTALL_DEPENDENCIES="${INSTALL_DEPENDENCIES:-true}"
BUILD_ASSETS="${BUILD_ASSETS:-true}"
NPM_BUILD_COMMAND="${NPM_BUILD_COMMAND:-npm run production}"
FRONTEND_ASSET_ARCHIVE="deployment/frontend-assets.tar.gz"
FRONTEND_ASSET_CHECKSUM="deployment/frontend-assets.sha256"

# Only generated/static assets are synchronized. Runtime uploads are preserved.
SYNC_FOLDERS="css js fonts webfonts images modules"
SYNC_ROOT_FILES="favicon.ico manifest.json manifest.webmanifest mix-manifest.json offline.html service-worker.js robots.txt"

# Optional public HTTPS endpoint, for example https://shop.example.com/login.
DEPLOY_HEALTH_URL="${DEPLOY_HEALTH_URL:-}"

# Copy to .env on the server and supply secrets there, never in Git.
APP_NAME=Proshop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-shop.example
WEB_INSTALLER_ENABLED=false

LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proshop
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Native ProShop storefront. Enable only after catalogue and PayFast pilot approval.
SHOP_ENABLED=false
SHOP_CHECKOUT_ENABLED=false
SHOP_CHANNEL=main
SHOP_PRODUCTS_PER_PAGE=24
SHOP_CART_LIFETIME_MINUTES=10080
SHOP_RESERVATION_MINUTES=20
INVOICE_SCANNING_ENABLED=false
INVOICE_SCANNING_DRIVER=openai
INVOICE_SCANNING_DISK=invoice_scans
INVOICE_SCANNING_MAX_FILE_KB=12288
INVOICE_SCANNING_MAX_FILES=10
INVOICE_SCANNING_MAX_TOTAL_FILE_KB=30720
# Set securely on the server before enabling invoice scanning:
# OPENAI_API_KEY=
FILESYSTEM_DRIVER=local

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Proshop

# Native storefront remains closed until catalogue, checkout and PayFast pilot approval.
SHOP_ENABLED=false
SHOP_CHECKOUT_ENABLED=false
SHOP_CHANNEL=main
SHOP_PAYFAST_ENABLED=false
SHOP_PAYFAST_SANDBOX=true
SHOP_PAYFAST_MERCHANT_ID=
SHOP_PAYFAST_MERCHANT_KEY=
SHOP_PAYFAST_PASSPHRASE=

# Court Lights is disabled until its separate database, HTTPS host, worker,
# PayFast account and supervised Shelly acceptance have all been completed.
LIGHTS_ENABLED=false
LIGHTS_MODE=live
LIGHTS_DB_HOST=127.0.0.1
LIGHTS_DB_PORT=3306
LIGHTS_DB_DATABASE=proshop_lights
LIGHTS_DB_USERNAME=
LIGHTS_DB_PASSWORD=
LIGHTS_RATE_CENTS=6000
LIGHTS_CUTOFF_TIMEZONE=Africa/Johannesburg
LIGHTS_REQUIRE_VERIFIED_EMAIL=true
LIGHTS_SUPPORT_EMAIL=lights@example.com

LIGHTS_PAYFAST_ENABLED=false
LIGHTS_PAYFAST_SANDBOX=true
LIGHTS_PAYFAST_MERCHANT_ID=
LIGHTS_PAYFAST_MERCHANT_KEY=
LIGHTS_PAYFAST_PASSPHRASE=

# Do not enable these until the supervised hardware pilot has passed.
LIGHTS_SHELLY_AUTH_KEY=
LIGHTS_SHELLY_LIVE_ENABLED=false
LIGHTS_CUSTOMER_CONTROL_ENABLED=false
